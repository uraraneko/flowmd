{
  "name": "flowmd",
  "version": "0.1.0",
  "description": "Streaming Markdown for Vue 3, with syntax highlighting, math, diagrams and custom renderers.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uraraneko/streamdown-vue.git"
  },
  "homepage": "https://github.com/uraraneko/streamdown-vue#readme",
  "bugs": {
    "url": "https://github.com/uraraneko/streamdown-vue/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./code": {
      "types": "./dist/plugins/code.d.ts",
      "import": "./dist/plugins/code.js"
    },
    "./math": {
      "types": "./dist/plugins/math.d.ts",
      "import": "./dist/plugins/math.js"
    },
    "./mermaid": {
      "types": "./dist/plugins/mermaid.d.ts",
      "import": "./dist/plugins/mermaid.js"
    },
    "./cjk": {
      "types": "./dist/plugins/cjk.d.ts",
      "import": "./dist/plugins/cjk.js"
    }
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "NOTICE",
    "upstream.json",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/API.md",
    "docs/PARITY.md",
    "docs/RELEASING.md",
    "docs/VALIDATION.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.declarations.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:parity": "vitest run test/parity",
    "format": "prettier --write index.ts lib hooks plugins test __tests__ scripts docs styles.css '*.json' '*.ts' '*.md' .github",
    "format:check": "prettier --check index.ts lib hooks plugins test __tests__ scripts docs styles.css '*.json' '*.ts' '*.md' .github",
    "check": "pnpm format:check && pnpm verify:upstream && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:package",
    "prepack": "pnpm build",
    "test:browser": "playwright test",
    "preview:parity": "vite --config vite.browser.config.ts",
    "verify:upstream": "node scripts/verify-upstream.mjs && node scripts/verify-ui-source.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "peerDependencies": {
    "katex": "^0.16.27",
    "mermaid": "^11.16.1",
    "shiki": "^4.4.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/unist": "3.0.3",
    "clsx": "2.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "html-url-attributes": "3.0.1",
    "marked": "18.0.11",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "rehype-harden": "1.1.8",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remend": "1.4.0",
    "tailwind-merge": "3.6.0",
    "type-fest": "4.41.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "unist-util-visit-parents": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/server-renderer": "^3.5.0",
    "@vue/test-utils": "^2.4.10",
    "esbuild": "^0.27.7",
    "jsdom": "^27.3.0",
    "katex": "^0.16.27",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-stringify": "11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
